# Copy this file to .env and fill in real values:   copy .env.example .env
# .env is git-ignored. Never commit it: it holds passwords, API keys and the JWT secret.

# ---------------------------------------------------------------------------
# Required by server.js (it refuses to start without a JWT_SECRET)
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional: a separate secret for hashing one-time email codes. Falls back to JWT_SECRET.
# CODE_SECRET=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace-me
PGDATABASE=chat_app

# ---------------------------------------------------------------------------
# AI service (ai-service.js)
# ---------------------------------------------------------------------------
AI_PORT=3001
OLLAMA_URL=http://localhost:11434
MODEL_NAME=qwen2.5vl:7b        # must be a vision model if the app sends photos
AI_NAME=MashfyAI               # the name the assistant uses for itself
# PUBLIC_MODEL_NAME=mashfyai   # defaults to a slug of AI_NAME
AI_MAX_CONCURRENT=6            # replies generated at once before callers get "busy"
AI_RATE_LIMIT_PER_MIN=120      # per IP; the CRUD server calls from one IP for all users
TRUST_PROXY=1                  # number of proxies in front of the AI service (0 = none)

# Shared key between server.js and ai-service.js. Must be 24+ characters.
# Generate with: node -e "console.log('sk-' + require('crypto').randomBytes(32).toString('hex'))"
AI_API_KEY=

# Where server.js finds the AI service (default is the local one above).
# Set this when the AI service runs on another PC, e.g. an ngrok URL:
# AI_BASE_URL=https://other-pc.ngrok-free.dev/v1

# ---------------------------------------------------------------------------
# CRUD server (server.js)
# ---------------------------------------------------------------------------
PORT=3000
MAX_HISTORY_MESSAGES=12
WHISPER_URL=http://127.0.0.1:8001
# CORS_ORIGIN=https://app.example.com   # only needed for a web build; comma-separated list

# Optional: enables the "web search" toggle. Get a key at https://serper.dev
SERPER_API_KEY=

# ---------------------------------------------------------------------------
# Email (one-time codes). With these unset, codes are printed to the console
# instead of being emailed (development only; production requires SMTP).
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password      # Gmail: Account -> Security -> App passwords
MAIL_FROM="MashfyAI <you@gmail.com>"
